{
  "expo": {
    "name": "Drink Awareness",
    "slug": "drink-awareness",
    "version": "1.0.0",
    "runtimeVersion": "57.0.0",
    "orientation": "portrait",
    "cli": {
      "appVersionSource": "remote"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "drinkawareness",
    "description": "Track your drinking habits with AI coaching and health insights",
    "owner": "mattreid390",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#001858",
          "sounds": [
            "./assets/notification-sound.wav"
          ]
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.drinkaware.app",
          "enableNativePay": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drinkaware.app",
      "buildNumber": "1",
      "deploymentTarget": "13.0",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "We send notifications about your drinking goals and achievements",
        "NSHealthShareUsageDescription": "We use your health data to provide personalized coaching and insights",
        "NSHealthUpdateUsageDescription": "We log health events when you track your drinking",
        "NSLocalNetworkUsageDescription": "We use local network for synchronization",
        "NSBonjourServiceTypes": [
          "_http._tcp"
        ],
        "NSCameraUsageDescription": "Camera access is not required",
        "NSPhotoLibraryUsageDescription": "Photo library access is not required",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:drinkaware.app"
      ],
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:drinkaware.app"
        ]
      }
    },
    "android": {
      "package": "com.drinkaware.app",
      "versionCode": 1,
      "minSdkVersion": 24,
      "targetSdkVersion": 34,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "drinkaware.app"
            },
            {
              "scheme": "drinkawareness"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a262b3e8-4b22-47e3-8a83-7bd35e48f95c"
      }
    }
  }
}
